# Copy to .env and fill in. Every variable the site reads is listed here.

# The public address of the site, as people type it. Use https:// in production.
SITE_URL=http://localhost:8080
# The one HTTP port the site is served on.
HTTP_PORT=8080
# Addresses of proxies in front of the site whose X-Forwarded-For header is
# believed, as CIDR ranges separated by spaces. "private_ranges" covers
# localhost and private networks.
TRUSTED_PROXIES=private_ranges

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-something-long-and-random

# Where sign-in email is sent from, over SMTP. Percent-encode special
# characters in the user and password, e.g. @ as %40.
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Elgeis Map <map@example.com>"
