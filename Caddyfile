# Serves the map and routes /api to the backend. Only HTTP: HTTPS is up to
# whatever sits in front of this (see "Deploying" in the README).
{
	auto_https off
	servers {
		# Proxies in front of this one whose X-Forwarded-For we believe.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

:80 {
	encode
	# Browsers check these on every load, so a deploy shows up at once rather
	# than mixing new scripts with a cached old stylesheet. The page is served
	# at every path that isn't a file (see below).
	@code not path /api* /dist/layers/* /favicon.png /dynmap.jpg
	header @code Cache-Control no-cache

	handle /api* {
		# The backend sees one address: the real client, as worked out above.
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Development only: tells open pages to reload when the frontend changes.
	handle /reload {
		reverse_proxy frontend:8000
	}

	# Built from the layers repo by the backend.
	handle_path /dist/layers/* {
		root * /srv/built/layers
		file_server
	}

	handle_path /dist/* {
		root * /srv/dist
		file_server
	}

	# Every other path is the page, which opens what the path names, like
	# /moderate/accounts.
	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server {
			# In dev this is the whole checkout, so keep the private bits out.
			hide .* node_modules secrets
		}
	}
}
